rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -- HELPERS --
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -- VALIDATION HELPERS --
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'purchasePrice', 'sellingPrice', 'quantity', 'minQuantity']) &&
             data.name is string && data.name.size() <= 200 &&
             data.purchasePrice is number && data.purchasePrice >= 0 &&
             data.sellingPrice is number && data.sellingPrice >= 0 &&
             data.quantity is number &&
             data.minQuantity is number &&
             (data.get('barcode', '') is string) &&
             (data.get('posQuantity', 0) is number);
    }

    function isValidSupplier(data) {
      return data.keys().hasAll(['name', 'phone']) &&
             data.name is string && data.name.size() <= 200 &&
             data.phone is string && data.phone.size() <= 50;
    }

    function isValidDebt(data) {
      return data.keys().hasAll(['customerName', 'totalAmount', 'status']) &&
             data.customerName is string && data.customerName.size() <= 200 &&
             data.totalAmount is number &&
             data.status in ['paid', 'unpaid'];
    }

    function isValidTransaction(data) {
       return data.keys().hasAll(['productId', 'type', 'quantityChange', 'date']) &&
              data.productId is string &&
              data.type in ['purchase', 'sale', 'jard', 'adjustment'] &&
              data.quantityChange is number &&
              data.date is string;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['date', 'totalRevenue', 'totalProfit', 'totalRemainingValue', 'items', 'type']) &&
             data.date is timestamp &&
             data.totalRevenue is number &&
             data.totalProfit is number &&
             data.totalRemainingValue is number &&
             data.items is list &&
             data.type is string &&
             (data.get('surplusValueUnverified', 0) is number && data.get('surplusValueUnverified', 0) >= 0) &&
             (data.get('surplusItemsCount', 0) is number && data.get('surplusItemsCount', 0) >= 0) &&
             (data.get('surplusTotalQuantity', 0) is number && data.get('surplusTotalQuantity', 0) >= 0) &&
             (data.get('totalExpenses', 0) is number) &&
             (data.get('netProfit', 0) is number) &&
             (data.get('expensesDeducted', false) is bool);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['action', 'entityType', 'entityId', 'entityName', 'timestamp']) &&
             data.action is string && data.action.size() <= 50 &&
             data.entityType is string && data.entityType.size() <= 100 &&
             data.entityId is string && data.entityId.size() <= 128 &&
             data.entityName is string && data.entityName.size() <= 200 &&
             data.timestamp is timestamp &&
             (data.get('details', '') is string || data.get('details', null) == null);
    }

    // -- PATHS --
    match /users/{userId} {
      // User settings
      match /settings/config {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Products
      match /products/{productId} {
        allow get: if isOwner(userId) && isValidId(productId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(productId) && isValidProduct(incoming());
        allow update: if isOwner(userId) && isValidId(productId) && isValidProduct(incoming());
        allow delete: if isOwner(userId) && isValidId(productId);
      }

      // Suppliers
      match /suppliers/{supplierId} {
        allow get: if isOwner(userId) && isValidId(supplierId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(supplierId) && isValidSupplier(incoming());
        allow update: if isOwner(userId) && isValidId(supplierId) && isValidSupplier(incoming());
        allow delete: if isOwner(userId) && isValidId(supplierId);
      }

      // Debts
      match /debts/{debtId} {
        allow get: if isOwner(userId) && isValidId(debtId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(debtId) && isValidDebt(incoming());
        allow update: if isOwner(userId) && isValidId(debtId) && isValidDebt(incoming());
        allow delete: if isOwner(userId) && isValidId(debtId);
      }

      // Categories
      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Transactions
      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(transactionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming());
        allow update: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming());
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      // Reports (Inventory & Periodic)
      match /reports/{reportId} {
        allow get, list, delete: if isOwner(userId) && isValidId(reportId);
        allow create, update: if isOwner(userId) && isValidId(reportId) && isValidReport(incoming());
      }

      // Audit Logs (Immutable / Append-Only)
      match /auditLogs/{logId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAuditLog(incoming());
        allow update, delete: if false; // Strict immutability for audit integrity
      }

      // Catch-all for subcollections not explicitly defined yet but in blueprint
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
